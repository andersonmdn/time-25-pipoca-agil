{
  "name": "@chargemap/api",
  "version": "1.0.0",
  "description": "",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "dev": "tsx -r dotenv/config src/server.ts NodeEnv=development",
    "dev:test": "tsx -r dotenv/config src/server.ts NodeEnv=test",
    "build": "tsc -p tsconfig.json && prisma generate",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist node_modules",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:reset": "prisma migrate reset",
    "prisma:studio": "prisma studio",
    "test": "vitest",
    "test:watch": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "prestart": "pnpm --filter @chargemap/validations build && prisma generate",
    "postinstall": "pnpm --filter @chargemap/validations build && prisma generate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@chargemap/validations": "workspace:*",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.1",
    "@fastify/jwt": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.5.2",
    "@fastify/swagger-ui": "^5.2.3",
    "@prisma/client": "^6.16.1",
    "argon2": "^0.44.0",
    "dotenv": "^17.2.2",
    "fastify": "^5.6.1",
    "fastify-type-provider-zod": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.9.5",
    "pino-pretty": "^13.1.1",
    "prisma": "^6.16.1",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.3.1",
    "@types/supertest": "^6.0.3",
    "@vitest/ui": "^3.2.4",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4",
    "yaml": "^2.8.1"
  }
}
